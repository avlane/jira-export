      "description": {
        "version": 1,
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2
            },
            "content": [
              {
                "type": "text",
                "text": "Summary"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Users on the "
              },
              {
                "type": "text",
                "text": "login page",
                "marks": [
                  {
                    "type": "strong"
                  }
                ]
              },
              {
                "type": "text",
                "text": " see a spinner for 30 seconds and then a timeout. "
              },
              {
                "type": "text",
                "text": "Reported by "
              },
              {
                "type": "mention",
                "attrs": {
                  "id": "5b6a3c1f2d8e4a0b9c7f1e22",
                  "text": "@Bob Okafor",
                  "accessLevel": ""
                }
              },
              {
                "type": "text",
                "text": "."
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "type": "text",
                "text": "Steps to reproduce"
              }
            ]
          },
          {
            "type": "orderedList",
            "attrs": {
              "order": 1
            },
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Open the login page"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Enter valid credentials"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Wait for the redirect"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Expected: redirect within 2 seconds.",
                "marks": [
                  {
                    "type": "em"
                  }
                ]
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Affects Chrome and Firefox"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Not reproducible on staging"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "codeBlock",
            "attrs": {
              "language": "bash"
            },
            "content": [
              {
                "type": "text",
                "text": "curl -s -o /dev/null -w '%{time_total}' https://app.example.com/login"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "See the "
              },
              {
                "type": "text",
                "text": "runbook",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "https://wiki.example.com/runbooks/login"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " for rollback steps."
              }
            ]
          }
        ]
      },
